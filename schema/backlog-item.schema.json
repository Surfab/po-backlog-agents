{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backlog-snapshot.schema.json",
  "title": "Snapshot normalizzato del backlog",
  "description": "Formato unico letto dagli agent di analisi. Lo scrive solo backlog-sync.",
  "type": "object",
  "required": ["generato_il", "fonti", "campi_non_mappati", "items"],
  "additionalProperties": false,
  "properties": {
    "generato_il": { "type": "string", "format": "date-time" },
    "fonti": {
      "type": "array",
      "description": "Una voce per tool letto, con il modo in cui è stato letto.",
      "items": {
        "type": "object",
        "required": ["tool", "modalita", "item_letti"],
        "additionalProperties": false,
        "properties": {
          "tool": { "type": "string" },
          "modalita": { "enum": ["mcp", "csv", "sample"] },
          "adapter": { "type": "string" },
          "item_letti": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    },
    "campi_non_mappati": {
      "type": "array",
      "description": "Campi che backlog-sync non ha saputo tradurre. Mai indovinare: si dichiara qui.",
      "items": {
        "type": "object",
        "required": ["tool", "campo", "motivo"],
        "additionalProperties": false,
        "properties": {
          "tool": { "type": "string" },
          "campo": { "type": "string" },
          "esempio_valore": {},
          "motivo": { "type": "string" },
          "item_coinvolti": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id", "tool", "url", "tipo", "titolo", "descrizione", "acceptance_criteria",
        "stato", "stato_originale", "priorita", "stima", "sprint", "parent",
        "dipendenze", "label", "aggiornato_il", "extra"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+:.+$",
          "description": "Formato tool:chiave, es. jira:PAY-112 o notion:PAYDISC-2."
        },
        "tool": { "type": "string", "description": "Nome dell'adapter, es. jira, notion." },
        "url": { "type": ["string", "null"] },
        "tipo": { "enum": ["opportunity", "epic", "story", "bug", "task", "spike"] },
        "tipo_originale": { "type": ["string", "null"] },
        "titolo": { "type": "string" },
        "descrizione": { "type": ["string", "null"] },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Un criterio per voce. Array vuoto = assenti."
        },
        "stato": { "enum": ["todo", "in_progress", "blocked", "done"] },
        "stato_originale": { "type": "string" },
        "priorita": {
          "type": ["object", "null"],
          "required": ["valore", "originale"],
          "additionalProperties": false,
          "properties": {
            "valore": { "enum": ["critica", "alta", "media", "bassa", null] },
            "originale": { "type": ["string", "null"] }
          }
        },
        "stima": {
          "type": ["object", "null"],
          "description": "null = non stimato. Non usare 0 per dire 'manca'.",
          "required": ["valore", "unita"],
          "additionalProperties": false,
          "properties": {
            "valore": { "type": "number" },
            "unita": { "enum": ["story_point", "ore", "giorni", "tshirt"] }
          }
        },
        "wsjf": {
          "type": ["object", "null"],
          "description": "Input WSJF se il tool li contiene. Ogni campo assente resta null.",
          "additionalProperties": false,
          "properties": {
            "business_value": { "type": ["number", "null"] },
            "time_criticality": { "type": ["number", "null"] },
            "risk_reduction": { "type": ["number", "null"] },
            "job_size": { "type": ["number", "null"] }
          }
        },
        "sprint": { "type": ["string", "null"] },
        "parent": { "type": ["string", "null"], "description": "Id normalizzato (tool:chiave) dell'epica o del padre." },
        "dipendenze": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "relazione"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "relazione": { "enum": ["bloccato_da", "blocca", "correlato", "duplica", "realizza"] }
            }
          }
        },
        "label": { "type": "array", "items": { "type": "string" } },
        "assegnatario": { "type": ["string", "null"] },
        "creato_il": { "type": ["string", "null"] },
        "aggiornato_il": { "type": "string", "description": "ISO 8601." },
        "extra": {
          "type": "object",
          "description": "Campi specifici del tool, con il nome originale. Niente va perso."
        }
      }
    }
  }
}
